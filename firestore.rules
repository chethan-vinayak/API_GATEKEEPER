rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check connection test for validate Connection
    match /_health/connection {
      allow read: if true;
      allow write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Incidents Collection
    match /incidents/{incidentId} {
      allow read: if true; // Public/Operator telemetry feed
      allow create: if isSignedIn() || true; // WAF gateway background telemetry recording
      allow update, delete: if isSignedIn();
    }

    // Banned IPs Collection
    match /banned_ips/{ipId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }
  }
}
